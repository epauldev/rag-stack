# Copiez ce fichier en `.env` pour modifier les valeurs par défaut. Tout est facultatif :
# les modèles se choisissent aussi dans l'interface (onglet Réglages), qui prime ensuite.

# --- LM Studio (sur la machine hôte) ---
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LMSTUDIO_API_KEY=lm-studio
# LLM_MODEL=                 # identifiant exact du modèle de chat dans LM Studio
# EMBED_MODEL=               # identifiant exact du modèle d'embedding (ex. un GGUF de BGE-M3)
# EMBED_QUERY_PREFIX=        # vide pour BGE-M3 ; "query: " pour multilingual-e5
# EMBED_DOC_PREFIX=          # vide pour BGE-M3 ; "passage: " pour multilingual-e5

# --- Interface ---
# APP_PORT=7860
# APP_USER=
# APP_PASSWORD=              # à définir si vous exposez l'interface sur le réseau local

# --- Reranker (cross-encoder local) : demande de reconstruire l'image ---
#   1) WITH_RERANKER=1 puis `docker compose build`   2) cocher « Reranker » dans Réglages
# WITH_RERANKER=0
# USE_RERANKER=false

# --- OCR et découpage ---
# OCR_LANGUAGE=fra+eng
# CHILD_CHARS=1500           # taille des passages indexés (~400 tokens)
# CHILD_OVERLAP=200
# PARENT_CHARS=4000          # taille du contexte transmis au modèle autour de chaque passage
